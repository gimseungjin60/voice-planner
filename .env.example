PORT=3000
SESSION_SECRET=아무_긴_랜덤_문자열

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=voiceplanner
DB_PASSWORD=
DB_NAME=voiceplanner

# Claude API (AI 요약·할 일 추출)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# 구글 OAuth (Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID, 웹 애플리케이션)
# EC2에서는 https://<도메인>/auth/google/callback 으로 바꾸고, 같은 주소를 콘솔의 '승인된 리디렉션 URI'에도 추가
# 노션은 사용자마다 연동 설정 화면에서 토큰을 넣으므로 .env 항목이 없다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# 강의 녹음 받아쓰기·브리핑 음성 (OpenAI). 대시보드에서 월 사용 한도 설정 권장
OPENAI_API_KEY=
