<%- include('partials/header') %>
<% const WEEK = ["일", "월", "화", "수", "목", "금", "토"];
   const open = subject.tasks.filter((t) => t.status !== 'done');
   const doneN = subject.tasks.length - open.length;
   const pct = subject.tasks.length ? Math.round((doneN / subject.tasks.length) * 100) : 0;
   const md = (v) => v ? `${Number(v.slice(5, 7))}/${Number(v.slice(8, 10))}` : '';
   const MAIL = { pending: '새 후보', accepted: '추가함', ignored: '무시함' }; %>
<header class="subnav">
  <div class="subnav-inner">
    <h1 class="subnav-title"><span class="dot-lg" style="--c: <%= subject.color %>"></span><%= subject.name %>
      <span class="count"><%= subject.professor || '' %></span></h1>
    <div class="subnav-actions"><a class="btn sm gray" href="/timetable">시간표에서 수정</a></div>
  </div>
</header>

<main class="container stack">
  <div class="stat-grid">
    <div class="stat-card"><p class="label">남은 할 일</p><p class="value"><%= open.length %></p><p class="fine">전체 <%= subject.tasks.length %>개</p></div>
    <div class="stat-card"><p class="label">완료율</p><p class="value"><%= pct %>%</p>
      <div class="progress" style="--c: <%= subject.color %>"><span style="width: <%= pct %>%"></span></div></div>
    <div class="stat-card"><p class="label">음성 메모</p><p class="value"><%= subject.memos.length %></p><p class="fine">최근 20개까지</p></div>
    <div class="stat-card"><p class="label">수업</p><p class="value"><%= subject.schedules.length %></p>
      <p class="fine"><%= subject.schedules.map((x) => WEEK[x.day_of_week] + ' ' + x.start_time.slice(0, 5)).join(', ') || '수업 시간 없음' %></p></div>
  </div>

  <div class="grid-2">
    <section>
      <p class="section-label">할 일</p>
      <% if (!subject.tasks.length) { %>
        <div class="card empty"><div class="empty-icon"><svg class="i"><use href="#i-check"/></svg></div><strong>할 일이 없어요</strong>음성 메모로 말하면 이 과목으로 정리돼요</div>
      <% } else { %>
        <div class="group">
          <% subject.tasks.forEach((t) => { %>
            <a class="row" href="/tasks">
              <span class="icon-tile <%= t.status === 'done' ? 'green' : 'ink' %>"><svg class="i"><use href="#i-<%= t.status === 'done' ? 'check' : 'flag' %>"/></svg></span>
              <div class="row-main">
                <div class="row-title <%= t.status === 'done' ? 'struck' : '' %>"><%= t.title %></div>
                <div class="row-sub"><% if (t.due_at) { %><span class="due" data-due="<%= t.due_at %>" <%= t.status === 'done' ? 'data-done=1' : '' %>></span><% } else { %>마감 없음<% } %></div>
              </div>
              <span class="badge"><%= { todo: '할 일', doing: '진행 중', done: '완료' }[t.status] %></span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>

    <div class="stack">
      <section>
        <p class="section-label">음성 메모</p>
        <% if (!subject.memos.length) { %>
          <div class="card empty"><strong>메모가 없어요</strong></div>
        <% } else { %>
          <div class="group">
            <% subject.memos.forEach((m) => { %>
              <a class="row" href="/memos/<%= m.memo_id %>">
                <span class="icon-tile"><svg class="i"><use href="#i-<%= m.memo_type === 'lecture' ? 'wave' : 'note' %>"/></svg></span>
                <div class="row-main">
                  <div class="row-title clamp-1"><%= (m.summary || m.transcript).split('\n')[0] %></div>
                  <div class="row-sub"><%= m.memo_type === 'lecture' ? '강의 녹음' : '짧은 메모' %> · <%= md(m.created_at) %></div>
                </div>
                <svg class="i sm chev"><use href="#i-chevron"/></svg>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section>
        <p class="section-label">메일에서 찾은 과제</p>
        <% if (!subject.mails.length) { %>
          <div class="card empty"><strong>메일 과제가 없어요</strong></div>
        <% } else { %>
          <div class="group">
            <% subject.mails.forEach((m) => { %>
              <a class="row" href="/inbox">
                <span class="icon-tile green"><svg class="i"><use href="#i-mail"/></svg></span>
                <div class="row-main">
                  <div class="row-title clamp-1"><%= m.ai_title || m.subject %></div>
                  <div class="row-sub clamp-1"><%= m.subject %> · <%= md(m.received_at) %></div>
                </div>
                <span class="badge"><%= MAIL[m.status] %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
