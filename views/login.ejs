<%- include('partials/header') %>
<% const signup = mode === 'signup'; %>
<div class="auth">
  <section class="auth-hero" aria-label="서비스 소개">
    <a class="brand" href="/login"><span class="logo" aria-hidden="true"><i></i><i></i><i></i></span>보이스 플래너</a>
    <h1>말하면, 정리됩니다.</h1>
    <p class="lead">흩어진 수업·과제·일정을 한 화면에.<br />떠오른 할 일은 그냥 말로 남기세요.</p>
    <div class="demo-card" aria-hidden="true">
      <p class="say">“데이터베이스 교수님이 <mark>다음 주 화요일까지</mark> ERD 과제 내래”</p>
      <p class="by"><span class="logo"><i></i><i></i><i></i></span>AI가 할 일로 정리했어요</p>
      <div class="todo">
        <span class="check"></span><span class="grow">ERD 과제 제출</span>
        <span class="chip" style="--c: #F5A86C">데이터베이스</span><span class="due num">D-8 · 12/1 23:59</span>
      </div>
    </div>
    <ol class="features">
      <li>말로 남기면 AI가 정리<span>“다음 주 화요일까지”도 정확한 날짜로 바꿔요.</span></li>
      <li>시간표·구글 캘린더·메일 과제를 한 줄로<span>수업, 일정, 마감이 하나의 타임라인에 모여요.</span></li>
      <li>아침 브리핑을 읽어드려요<span>오늘 수업과 마감을 소리로 들려드려요.</span></li>
    </ol>
  </section>

  <main class="auth-main">
    <div class="auth-box">
      <nav class="seg lg" aria-label="로그인 또는 회원가입">
        <a href="/login" class="<%= signup ? '' : 'active' %>" <%- signup ? '' : 'aria-current="page"' %>>로그인</a>
        <a href="/signup" class="<%= signup ? 'active' : '' %>" <%- signup ? 'aria-current="page"' : '' %>>회원가입</a>
      </nav>
      <h2><%= signup ? '처음 오셨군요' : '다시 만나서 반가워요' %></h2>
      <form id="auth-form" data-mode="<%= mode %>" novalidate>
        <% if (signup) { %>
          <div class="field"><label for="user_name">이름</label><input id="user_name" name="user_name" maxlength="50" autocomplete="name" required placeholder="이름" /></div>
        <% } %>
        <div class="field"><label for="email">이메일</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="<%= signup ? '학교 메일도 좋아요' : 'student@vp.com' %>" /></div>
        <div class="field">
          <label for="password">비밀번호</label>
          <input id="password" name="password" type="password" required <%- signup ? 'aria-describedby="pw-help"' : '' %>
            autocomplete="<%= signup ? 'new-password' : 'current-password' %>" placeholder="<%= signup ? '8자 이상' : '비밀번호' %>" />
          <% if (signup) { %><p class="help" id="pw-help">8자 이상 입력해 주세요.</p><% } %>
        </div>
        <div class="error-msg" id="auth-error" role="alert"></div>
        <button class="btn xl"><%= signup ? '가입하기' : '로그인' %></button>
      </form>
      <% if (!signup) { %><p class="demo-account">체험 계정 <b>student@vp.com</b> / <b>test1234</b></p><% } %>
    </div>
  </main>
</div>
<script src="/js/auth.js" defer></script>
<%- include('partials/footer') %>
