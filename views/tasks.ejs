<%- include('partials/header') %>
<main class="container">
  <div class="page-head">
    <div>
      <h1>할 일 <span class="count num" id="total-count"></span></h1>
      <p>말로 남긴 할 일과 직접 추가한 할 일을 한곳에서 관리해요.</p>
    </div>
    <div class="seg" id="view-toggle" role="group" aria-label="보기 방식">
      <button type="button" data-view="calendar"><svg class="i sm" aria-hidden="true"><use href="#i-calendar"/></svg>달력</button>
      <button type="button" data-view="board"><svg class="i sm" aria-hidden="true"><use href="#i-grid"/></svg>보드</button>
    </div>
  </div>

  <form class="composer" id="task-form">
    <svg class="i" aria-hidden="true"><use href="#i-plus"/></svg>
    <input id="t-title" name="title" class="qa-title" maxlength="200" required placeholder="새 할 일 (예: 운영체제 3장 복습)" aria-label="할 일 제목" />
    <div class="qa-opts">
      <div class="qa-due">
        <label class="qa-label" for="t-due"><svg class="i sm" aria-hidden="true"><use href="#i-clock"/></svg>마감일</label>
        <div class="due-quick" role="group" aria-label="마감 빠르게 고르기">
          <button type="button" data-quick="today">오늘</button><button type="button" data-quick="tomorrow">내일</button><button type="button" data-quick="week">이번 주</button>
        </div>
        <input id="t-due" name="due_at" type="datetime-local" class="pill" />
      </div>
      <label class="qa-select"><svg class="i sm" aria-hidden="true"><use href="#i-flag"/></svg><span class="sr-only">우선순위</span>
        <select id="t-priority" name="priority"><option value="mid">보통</option><option value="high">높음</option><option value="low">낮음</option></select></label>
      <label class="qa-select"><svg class="i sm" aria-hidden="true"><use href="#i-book"/></svg><span class="sr-only">과목</span>
        <select id="t-subject" name="subject_id"><option value="">과목 없음</option>
          <% subjects.forEach((s) => { %><option value="<%= s.subject_id %>"><%= s.name %></option><% }) %></select></label>
      <button class="btn">추가</button>
    </div>
  </form>

  <nav class="filter-chips board-filter" id="subject-filter" aria-label="과목 필터">
    <button type="button" class="active" data-subject="" aria-pressed="true">모든 과목</button>
    <% subjects.forEach((s) => { %><button type="button" data-subject="<%= s.subject_id %>" data-c style="--c: <%= s.color %>" aria-pressed="false"><%= s.name %></button><% }) %>
  </nav>

  <section class="cal-view" id="cal-view" aria-label="월간 달력" hidden>
    <div class="cal-head">
      <div class="cal-nav">
        <button type="button" class="icon-btn" id="cal-prev" aria-label="이전 달"><svg class="i" aria-hidden="true"><use href="#i-chevron-left"/></svg></button>
        <label class="cal-title"><span id="cal-title"></span><input type="month" id="cal-month" aria-label="달 고르기" /></label>
        <button type="button" class="icon-btn" id="cal-next" aria-label="다음 달"><svg class="i" aria-hidden="true"><use href="#i-chevron"/></svg></button>
        <button type="button" class="btn line sm" id="cal-today">오늘</button>
      </div>
      <div class="cal-layers" id="cal-layers" role="group" aria-label="달력에 보일 것">
        <button type="button" class="layer task" data-layer="task" aria-pressed="true"><i aria-hidden="true"></i>할 일</button>
        <button type="button" class="layer class" data-layer="class" aria-pressed="true"><i aria-hidden="true"></i>수업</button>
        <button type="button" class="layer event" data-layer="event" aria-pressed="true"><span class="src-logo gcal" aria-hidden="true"><svg><use href="#logo-gcal"/></svg></span>일정</button>
      </div>
      <div class="cal-stats" id="cal-stats" aria-live="polite"></div>
    </div>
    <div class="cal-layout">
      <div class="cal-grid-wrap">
        <div class="cal-week" aria-hidden="true"><span class="sun">일</span><span>월</span><span>화</span><span>수</span><span>목</span><span>금</span><span class="sat">토</span></div>
        <div class="cal-grid" id="cal-grid" role="grid"></div>
        <p class="cal-hint">할 일을 다른 날짜로 끌어다 놓으면 마감일이 바뀌어요. 수업은 시간표, 일정은 구글 캘린더에서 가져와 보여주기만 해요.</p>
      </div>
      <aside class="cal-side" id="cal-side" aria-live="polite"></aside>
    </div>
  </section>

  <div class="board">
    <section class="column" data-status="todo" aria-label="할 일"><div class="column-head"><span class="dot"></span><h3>할 일</h3><span class="count"></span></div><div class="cards"></div></section>
    <section class="column" data-status="doing" aria-label="진행 중"><div class="column-head"><span class="dot"></span><h3>진행 중</h3><span class="count"></span></div><div class="cards"></div></section>
    <section class="column" data-status="done" aria-label="완료"><div class="column-head"><span class="dot"></span><h3>완료</h3><span class="count"></span></div><div class="cards"></div></section>
  </div>
</main>
<script id="tasks-data" type="application/json"><%- JSON.stringify(tasks).replace(/</g, '\\u003c') %></script>
<script src="/js/tasks.js" defer></script>
<script src="/js/tasks-calendar.js" defer></script>
<%- include('partials/footer') %>
