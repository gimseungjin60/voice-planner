<%- include('partials/header') %>
<% const lecture = memo.memo_type === 'lecture';
   const WEEK = ["일", "월", "화", "수", "목", "금", "토"];
   const c = memo.created_at;
   const when = `${Number(c.slice(5, 7))}월 ${Number(c.slice(8, 10))}일 (${WEEK[new Date(c.slice(0, 10) + 'T12:00:00Z').getUTCDay()]}) ${c.slice(11, 16)}`;
   const pad = (n) => String(n).padStart(2, '0');
   const s = memo.duration_sec;
   const dur = !s ? '' : s >= 3600 ? `${Math.floor(s / 3600)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}` : `${pad(Math.floor(s / 60))}:${pad(s % 60)}`;
   // 강의 요약: "• 핵심" 줄 + "[시험 포인트]" 아래 "★ 포인트" 줄
   const [mainPart, examPart = ''] = (memo.summary || '').split('[시험 포인트]');
   const lines = (txt, mark) => txt.split('\n').map((l) => l.trim().replace(mark, '').trim()).filter(Boolean);
   const title = memo.summary && !lecture ? memo.summary.split('\n')[0] : lecture ? (lines(mainPart, /^[•\-*]/)[0] || '강의 녹음') : `“${memo.transcript.slice(0, 30)}${memo.transcript.length > 30 ? '…' : ''}”`; %>
<main class="container">
  <a class="back" href="/memos"><svg class="i sm" aria-hidden="true"><use href="#i-chevron-left"/></svg>메모</a>
  <div class="detail-head">
    <div>
      <% if (memo.summary && !lecture) { %><p class="ai-label"><svg class="i" aria-hidden="true"><use href="#i-sparkles"/></svg>AI 한 줄 요약</p><% } %>
      <h1><%= title %></h1>
      <div class="detail-meta">
        <span class="badge"><svg class="i" aria-hidden="true"><use href="#i-<%= lecture ? 'lecture' : 'mic' %>"/></svg><%= lecture ? '강의 녹음' : '짧은 메모' %></span>
        <% if (memo.subject_name) { %><span class="chip" style="--c: <%= memo.subject_color %>"><%= memo.subject_name %></span><% } else { %><span class="chip none">과목 없음</span><% } %>
        <span><%= when %><%= dur ? ' · ' + dur : '' %></span>
      </div>
    </div>
    <button class="btn danger-line" id="delete-memo" data-id="<%= memo.memo_id %>"><svg class="i sm" aria-hidden="true"><use href="#i-trash"/></svg>삭제</button>
  </div>

  <div class="grid-2 detail">
    <div class="stack">
      <% if (lecture || !memo.summary) { %>
      <section class="card">
        <div class="card-head"><h2 class="sm"><span class="badge ai">AI 요약</span><%= lecture ? '핵심 정리' : '한 줄 요약' %></h2></div>
        <% if (!memo.summary) { %>
          <p class="summary warn">AI 요약이 없어요. 원문은 오른쪽에 그대로 남아 있어요.</p>
        <% } else { %>
          <ul class="points"><% lines(mainPart, /^[•\-*]/).forEach((l) => { %><li><%= l %></li><% }) %></ul>
          <% if (lines(examPart, /^★/).length) { %>
            <div class="exam"><b><svg class="i" aria-hidden="true"><use href="#i-star"/></svg>시험 포인트</b>
              <ul class="points"><% lines(examPart, /^★/).forEach((l) => { %><li><%= l %></li><% }) %></ul></div>
          <% } %>
        <% } %>
      </section>
      <% } %>

      <section class="card">
        <div class="card-head flush"><h2 class="sm">이 메모로 만든 할 일</h2><a class="link" href="/tasks">할 일 보드로</a></div>
        <% if (!memo.tasks.length) { %>
          <div class="empty compact">
            <p class="title">이 메모로 만든 할 일이 없어요</p>
            <p class="desc"><%= lecture ? '강의 녹음은 할 일 대신 요약과 시험 포인트를 남겨요.' : '메모를 다시 말해 할 일을 남겨 보세요.' %></p>
          </div>
        <% } else { %>
          <div class="list">
            <% memo.tasks.forEach((t) => { const done = t.status === 'done'; %>
              <div class="row">
                <span class="check <%= done ? 'on' : '' %>" aria-hidden="true"></span>
                <div class="row-main"><div class="row-title <%= done ? 'struck' : '' %>"><%= t.title %></div></div>
                <% if (t.status === 'doing') { %><span class="badge blue">진행 중</span><% } %>
                <% if (t.priority === 'high' && !done) { %><span class="prio-high"><svg class="i sm" aria-hidden="true"><use href="#i-flag"/></svg>중요</span><% } %>
                <% if (t.due_at) { %><span class="due" data-due="<%= t.due_at %>" <%= done ? 'data-done=1' : '' %>></span><% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>

    <section class="card">
      <div class="card-head"><h2 class="sm">원문</h2></div>
      <div class="transcript-text"><%= memo.transcript %></div>
      <p class="fine num card-note"><%= lecture ? '강의 받아쓰기' : '받아쓰기' %> · <%= memo.transcript.length.toLocaleString() %>자</p>
    </section>
  </div>
</main>
<script>
  document.getElementById("delete-memo").addEventListener("click", async (e) => {
    const id = e.currentTarget.dataset.id;
    if (!(await ask("이 메모를 삭제할까요?\n이 메모로 만든 할 일은 남아요. 메모는 되돌릴 수 없어요.", "삭제"))) return;
    const r = await api(`/api/memos/${id}`, { method: "DELETE" });
    if (r.ok) location.href = "/memos";
  });
</script>
<%- include('partials/footer') %>
