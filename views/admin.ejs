<%- include('partials/header') %>
<header class="subnav">
  <div class="subnav-inner"><h1 class="subnav-title">관리자</h1></div>
</header>
<main class="container">
  <div class="stat-grid">
    <div class="stat-card"><p class="label">가입자</p><p class="value"><%= stats.users.toLocaleString() %></p><p class="fine">전체 회원</p></div>
    <div class="stat-card"><p class="label">음성 메모</p><p class="value"><%= stats.memos.toLocaleString() %></p><p class="fine">누적</p></div>
    <div class="stat-card"><p class="label">할 일</p><p class="value"><%= stats.tasks.toLocaleString() %></p><p class="fine">누적</p></div>
    <div class="stat-card"><p class="label">AI 호출</p><p class="value"><%= stats.ai_calls.toLocaleString() %></p>
      <p class="fine">실패 <%= stats.ai_failed %>회 · 토큰 <%= stats.ai_tokens.toLocaleString() %></p></div>
  </div>

  <p class="section-label">회원 <%= users.length %>명</p>
  <div class="group table-scroll">
    <table class="data">
      <thead><tr><th>이름</th><th>이메일</th><th>권한</th><th class="hide-sm">메모</th><th class="hide-sm">할 일</th><th class="hide-sm">가입일</th><th></th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr>
            <td><b style="font-weight: 600"><%= u.user_name %></b><% if (u.user_id === user.user_id) { %> <span class="fine">(나)</span><% } %></td>
            <td class="muted"><%= u.email %></td>
            <td><span class="badge <%= u.role === 'admin' ? 'blue' : '' %>"><%= u.role === 'admin' ? '관리자' : '사용자' %></span></td>
            <td class="hide-sm"><%= u.memo_count %></td><td class="hide-sm"><%= u.task_count %></td>
            <td class="hide-sm muted"><%= u.created_at.slice(0, 10) %></td>
            <td style="text-align: right"><% if (u.user_id !== user.user_id) { %><button class="btn plain danger sm" data-delete="<%= u.user_id %>" data-name="<%= u.user_name %>">삭제</button><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>
<script>
  document.querySelectorAll("[data-delete]").forEach((b) =>
    b.addEventListener("click", async () => {
      if (!(await ask(`${b.dataset.name} 회원과 모든 데이터를 삭제할까요?\n되돌릴 수 없어요.`, "삭제"))) return;
      const r = await api(`/api/admin/users/${b.dataset.delete}`, { method: "DELETE" });
      if (r.ok) b.closest("tr").remove();
    }),
  );
</script>
<%- include('partials/footer') %>
