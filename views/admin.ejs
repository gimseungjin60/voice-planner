<%- include('partials/header') %>
<% const ymd = (v) => v.slice(0, 10).split('-').map(Number).join('. ') + '.'; %>
<main class="container">
  <div class="page-head">
    <div>
      <h1>관리자</h1>
      <p>회원과 AI 사용량을 한눈에 봐요.</p>
    </div>
  </div>

  <div class="stat-grid strip">
    <div class="stat"><p class="label">가입자</p><p class="value"><%= stats.users.toLocaleString() %></p></div>
    <div class="stat"><p class="label">음성 메모</p><p class="value"><%= stats.memos.toLocaleString() %></p></div>
    <div class="stat"><p class="label">할 일</p><p class="value"><%= stats.tasks.toLocaleString() %></p></div>
    <div class="stat"><p class="label">AI 호출</p><p class="value"><%= stats.ai_calls.toLocaleString() %></p>
      <p class="hint num"><span style="<%= stats.ai_failed ? 'color: var(--red); font-weight: 600' : '' %>">실패 <%= stats.ai_failed %>회</span> · 토큰 <%= stats.ai_tokens.toLocaleString() %></p></div>
  </div>

  <section class="list-card">
    <div class="table-head"><h2>회원 <span class="fine num" style="font-weight: 500"><%= users.length %>명</span></h2></div>
    <div style="position: relative; overflow-x: auto">
      <table class="data">
        <thead><tr><th scope="col">이름</th><th scope="col">이메일</th><th scope="col">권한</th><th scope="col" class="n">메모</th><th scope="col" class="n">할 일</th><th scope="col">가입일</th><th scope="col"><span class="sr-only">관리</span></th></tr></thead>
        <tbody>
          <% users.forEach((u) => { const me = u.user_id === user.user_id; %>
            <tr>
              <td><span class="who"><span class="avatar" aria-hidden="true"><%= u.user_name.charAt(0) %></span><%= u.user_name %><% if (me) { %><span class="fine">나</span><% } %></span></td>
              <td><%= u.email %></td>
              <td><span class="badge <%= u.role === 'admin' ? 'ink' : '' %>"><%= u.role === 'admin' ? '관리자' : '일반' %></span></td>
              <td class="n"><%= u.memo_count %></td><td class="n"><%= u.task_count %></td>
              <td class="num"><%= ymd(u.created_at) %></td>
              <td class="end"><% if (me) { %><span class="fine">본인</span><% } else { %><button class="btn line sm" data-delete="<%= u.user_id %>" data-name="<%= u.user_name %>">삭제</button><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="table-foot">본인 계정은 여기서 삭제할 수 없어요.</p>
  </section>
</main>
<script>
  document.querySelectorAll("[data-delete]").forEach((b) =>
    b.addEventListener("click", async () => {
      if (!(await ask(`${b.dataset.name}님을 삭제할까요?\n메모와 할 일도 함께 삭제돼요. 되돌릴 수 없어요.`, "삭제"))) return;
      const r = await api(`/api/admin/users/${b.dataset.delete}`, { method: "DELETE" });
      if (!r.ok) return;
      b.closest("tr").remove();
      toast(`${b.dataset.name}님을 삭제했어요`);
    }),
  );
</script>
<%- include('partials/footer') %>
