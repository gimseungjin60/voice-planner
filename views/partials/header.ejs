<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <title><%= title %> · 보이스 플래너</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%231d1d1f'/%3E%3Cg fill='white'%3E%3Crect x='11' y='11.5' width='2.6' height='9' rx='1.3'/%3E%3Crect x='14.7' y='8.5' width='2.6' height='15' rx='1.3'/%3E%3Crect x='18.4' y='10.5' width='2.6' height='11' rx='1.3'/%3E%3C/g%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <script src="/js/app.js" defer></script>
  <% if (user) { %><script src="/js/voice.js" defer></script><% } %>
</head>
<%
  // 화면별 포인트색·아이콘 (style.css "페이지별 포인트"). 과목 모아보기·메모 상세는 상위 화면 것을 따른다
  const pageKeys = { "/tasks": "tasks", "/timetable": "timetable", "/subjects": "timetable", "/memo": "memo", "/memos": "memos",
    "/inbox": "inbox", "/report": "report", "/settings": "settings", "/admin": "admin" };
  const p = locals.path || "";
  const pageKey = pageKeys[p] || pageKeys["/" + p.split("/")[1]] || "";
%>
<body<%- pageKey ? ` class="page-${pageKey}"` : "" %>>
<%- include('icons') %>
<% if (user) { %><%- include('nav') %><% } %>
