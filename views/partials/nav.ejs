<%
  const links = [
    ["/", "대시보드"], ["/memo", "음성 메모"], ["/memos", "메모"], ["/tasks", "할 일"],
    ["/timetable", "시간표"], ["/report", "리포트"], ["/inbox", "받은 편지함"], ["/settings", "연동"],
  ];
  if (user.role === "admin") links.push(["/admin", "관리자"]);
  // 지금 화면: 과목 모아보기는 시간표, 메모 상세는 메모로 표시
  const current = path.startsWith("/subjects/") ? "/timetable" : path.startsWith("/memos") ? "/memos" : path;
  const isActive = (href) => (href === "/" ? current === "/" : current === href || current.startsWith(href + "/"));
%>
<header class="gnav">
  <a class="brand" href="/"><span class="logo" aria-hidden="true"><i></i><i></i><i></i></span>보이스 플래너</a>
  <nav class="gnav-links" aria-label="주 메뉴">
    <% links.forEach(([href, label]) => { %>
      <a href="<%= href %>" <%- isActive(href) ? 'aria-current="page"' : '' %>><%= label %><% if (href === "/inbox") { %><span class="nav-badge" id="nav-inbox-badge"></span><% } %></a>
    <% }) %>
  </nav>
  <div class="gnav-user">
    <span class="avatar" aria-hidden="true"><%= (user.user_name || "?").charAt(0) %></span>
    <span class="name"><%= user.user_name %></span>
    <button class="logout" id="logout-btn" type="button">로그아웃</button>
  </div>
</header>
