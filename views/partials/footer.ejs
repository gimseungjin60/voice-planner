<% if (user) { %><%- include('assistant') %><% } %>
<div class="toast-wrap" id="toast-wrap" aria-live="polite"></div>
<dialog id="confirm-dialog" role="alertdialog" aria-labelledby="confirm-msg" aria-describedby="confirm-desc">
  <form method="dialog" class="alert-box">
    <h2 id="confirm-msg"></h2>
    <p id="confirm-desc"></p>
    <div class="alert-actions">
      <button class="btn gray lg" value="cancel" autofocus>취소</button>
      <button class="btn danger lg" value="ok" id="confirm-ok">확인</button>
    </div>
  </form>
</dialog>
</body>
</html>
