<%- include('partials/header') %>
<% const WEEK = ["일", "월", "화", "수", "목", "금", "토"];
   const when = (v) => `${Number(v.slice(5, 7))}/${Number(v.slice(8, 10))} (${WEEK[new Date(v.slice(0, 10) + 'T12:00:00Z').getUTCDay()]}) ${v.slice(11, 16)}`;
   const pad = (n) => String(n).padStart(2, '0');
   const dur = (s) => !s ? '' : s >= 3600 ? `${Math.floor(s / 3600)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}` : `${pad(Math.floor(s / 60))}:${pad(s % 60)}`;
   const first = (list.page - 1) * 10 + 1; // 한 쪽 10개 (routes/api/memos.js PAGE_SIZE)
   const pageUrl = (p) => `/memos?page=${p}${subject ? '&subject=' + subject : ''}`; %>
<main class="container narrow">
  <div class="page-head">
    <h1>메모 <span class="count num"><%= list.total %>개</span></h1>
    <nav class="filter-chips" aria-label="과목 필터">
      <a href="/memos" class="<%= subject ? '' : 'active' %>" <%- subject ? '' : 'aria-current="page"' %>>모든 과목</a>
      <% subjects.forEach((s) => { const on = subject === s.subject_id; %>
        <a href="/memos?subject=<%= s.subject_id %>" data-c style="--c: <%= s.color %>" class="<%= on ? 'active' : '' %>" <%- on ? 'aria-current="page"' : '' %>><%= s.name %></a>
      <% }) %>
    </nav>
  </div>

  <% if (!list.items.length) { %>
    <div class="card empty">
      <div class="empty-icon"><svg class="i"><use href="#i-mic"/></svg></div>
      <p class="title"><%= subject ? '이 과목의 메모가 없어요' : '아직 메모가 없어요' %></p>
      <p class="desc">떠오른 할 일을 말로 남겨 보세요.</p>
      <a class="btn" href="/memo">음성 메모 남기기</a>
    </div>
  <% } else { %>
    <div class="list-card list">
      <% list.items.forEach((m) => { const lecture = m.memo_type === 'lecture';
           const head = m.summary ? m.summary.split('\n')[0].replace(/^[•★]\s*/, '') : `“${m.transcript.slice(0, 40)}${m.transcript.length > 40 ? '…' : ''}”`; %>
        <a class="row" href="/memos/<%= m.memo_id %>">
          <span class="tile"><svg class="i"><use href="#i-<%= lecture ? 'lecture' : 'mic' %>"/></svg></span>
          <div class="row-main">
            <div class="row-title"><%= head %></div>
            <div class="row-sub">
              <span><%= lecture ? '강의 녹음' : '짧은 메모' %></span><span>·</span>
              <% if (m.subject_name) { %><span class="chip" style="--c: <%= m.subject_color %>"><%= m.subject_name %></span><% } else { %><span class="chip none">과목 없음</span><% } %>
              <span>·</span><span class="num"><%= when(m.created_at) %></span>
              <% if (!m.summary) { %><span class="badge" style="height: 22px">요약 전 · 원문</span><% } %>
            </div>
          </div>
          <div class="row-end"><span class="dur"><%= dur(m.duration_sec) %></span><svg class="i chev" aria-hidden="true"><use href="#i-chevron"/></svg></div>
        </a>
      <% }) %>
    </div>
    <div class="list-foot">
      <span class="fine num"><%= list.total %>개 중 <%= first %>~<%= first + list.items.length - 1 %></span>
      <% if (list.pages > 1) { %>
        <nav class="pager" aria-label="페이지">
          <% if (list.page > 1) { %><a href="<%= pageUrl(list.page - 1) %>" aria-label="이전 페이지"><svg class="i sm"><use href="#i-chevron-left"/></svg></a><% } else { %><span class="off"><svg class="i sm"><use href="#i-chevron-left"/></svg></span><% } %>
          <% for (let p = 1; p <= list.pages; p++) { %>
            <% if (p === list.page) { %><span class="active" aria-current="page"><%= p %></span><% } else { %><a href="<%= pageUrl(p) %>"><%= p %></a><% } %>
          <% } %>
          <% if (list.page < list.pages) { %><a href="<%= pageUrl(list.page + 1) %>" aria-label="다음 페이지"><svg class="i sm"><use href="#i-chevron"/></svg></a><% } else { %><span class="off"><svg class="i sm"><use href="#i-chevron"/></svg></span><% } %>
        </nav>
      <% } %>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>
