<%- include('partials/header') %>
<header class="subnav">
  <div class="subnav-inner">
    <h1 class="subnav-title">메모 <span class="count"><%= list.total %>개</span></h1>
    <div class="subnav-actions">
      <form method="get" action="/memos">
        <select name="subject" class="compact" aria-label="과목 필터" onchange="this.form.submit()">
          <option value="">모든 과목</option>
          <% subjects.forEach((s) => { %><option value="<%= s.subject_id %>" <%= subject === s.subject_id ? 'selected' : '' %>><%= s.name %></option><% }) %>
        </select>
      </form>
      <a class="btn sm" href="/memo"><svg class="i sm"><use href="#i-mic"/></svg>새 메모</a>
    </div>
  </div>
</header>

<main class="container narrow">
  <% if (!list.items.length) { %>
    <div class="card empty">
      <div class="empty-icon"><svg class="i"><use href="#i-note"/></svg></div>
      <strong><%= subject ? '이 과목의 메모가 없어요' : '아직 메모가 없어요' %></strong>
      떠오른 할 일을 말로 남겨 보세요
      <div><a class="btn" href="/memo"><svg class="i"><use href="#i-mic"/></svg>음성 메모 남기기</a></div>
    </div>
  <% } else { %>
    <div class="group">
      <% list.items.forEach((m) => { const lecture = m.memo_type === 'lecture'; %>
        <a class="row" href="/memos/<%= m.memo_id %>">
          <span class="icon-tile <%= lecture ? 'ink' : '' %>"><svg class="i"><use href="#i-<%= lecture ? 'wave' : 'note' %>"/></svg></span>
          <div class="row-main">
            <div class="row-title"><%= (m.summary || m.transcript).split('\n')[0].replace(/^[•★]\s*/, '').slice(0, 80) %></div>
            <div class="row-sub">
              <% if (m.subject_name) { %><span class="chip" style="--c: <%= m.subject_color %>"><%= m.subject_name %></span><% } %>
              <span><%= lecture ? '강의 녹음' : '짧은 메모' %></span>
              <% if (!m.summary) { %><span class="badge orange">요약 없음</span><% } %>
            </div>
          </div>
          <div class="row-end"><span class="fine num"><%= Number(m.created_at.slice(5, 7)) %>/<%= Number(m.created_at.slice(8, 10)) %> <%= m.created_at.slice(11, 16) %></span><svg class="i chev"><use href="#i-chevron"/></svg></div>
        </a>
      <% }) %>
    </div>
  <% } %>
  <% if (list.pages > 1) { %>
    <nav class="pager" aria-label="페이지">
      <% for (let p = 1; p <= list.pages; p++) { %>
        <% if (p === list.page) { %><span class="active" aria-current="page"><%= p %></span>
        <% } else { %><a href="/memos?page=<%= p %><%= subject ? '&subject=' + subject : '' %>"><%= p %></a><% } %>
      <% } %>
    </nav>
  <% } %>
</main>
<%- include('partials/footer') %>
